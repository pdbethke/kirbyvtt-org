---
// SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
// Wraps Starlight's own Header (search, theme toggle, social links) with the
// marketing nav, so /docs isn't a dead end: / and /mobius-box/ stay
// reachable from inside the docs chrome.
import Default from '@astrojs/starlight/components/Header.astro';
---

<div class="kirby-docs-header">
  <Default {...Astro.props}><slot /></Default>
  <!-- After Starlight's header, not before it: Starlight's own SiteTitle is
       the "Kirby" lockup, so putting a second "Kirby" link ahead of it made
       the bar read "Kirby  Mobius Box  Kirby". Home is reachable from the
       lockup itself, so this nav only needs the routes Starlight lacks. -->
  <nav class="marketing-nav" aria-label="Site">
    <a href="/">Home</a>
    <a href="/mobius-box/">Mobius Box</a>
  </nav>
</div>

<style>
  .kirby-docs-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
  .marketing-nav {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    margin-inline-start: auto;
  }
  .marketing-nav a {
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .marketing-nav a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
