---
// SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
//
// Posts to the Cloudflare Pages Function at /subscribe (functions/subscribe.ts),
// which verifies the Turnstile token server-side before anything is forwarded
// anywhere. The widget below is progressive enhancement, not the guard itself —
// a bot that skips the script and POSTs straight to /subscribe still has to
// clear siteverify there. See functions/subscribe.ts for that check.
const TURNSTILE_SITE_KEY = '0x4AAAAAAEZesQat8_1YAStk';
const { action = '/subscribe' } = Astro.props;
---
<form data-notify method="post" action={action}>
  <label for="email">Tell me when it's ready</label>
  <div class="control-row">
    <input id="email" name="email" type="email" required
           placeholder="you@example.com" autocomplete="email" />
    <button type="submit">Notify me</button>
  </div>

  {/*
    Turnstile widget. Loaded with defer so it never blocks the form from
    rendering or the submit button from being usable. If the script fails to
    load (network hiccup, blocked request), this div just stays empty — the
    form still POSTs normally, and the Function rejects it server-side for
    lacking a token. The submit button is never hidden behind the widget.
  */}
  <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>

  {/*
    Honeypot. Undiscriminating bots fill every field they find; a person never
    sees this one, so anything arriving with it populated can be dropped.

    Named "website" rather than anything resembling a trap, because the name is
    the bait. Hidden with an off-screen wrapper rather than `type="hidden"` or
    `display: none` — both are trivially detected and skipped by better bots,
    while an off-screen field looks real to a form parser.

    tabindex="-1" and autocomplete="off" keep it away from keyboard users and
    password managers, and aria-hidden keeps it out of the accessibility tree,
    so it costs a screen-reader user nothing.

    This is a filter, not a wall: it stops the volume, not a targeted scraper.
    The defence that protects the LIST is double opt-in at the mail provider —
    a bot address never confirms.
  */}
  <div class="hp" aria-hidden="true">
    <label for="website">Leave this field empty</label>
    <input id="website" name="website" type="text"
           tabindex="-1" autocomplete="off" />
  </div>

  {/*
    Where the script reports the outcome. `hidden` until there is something
    to say, so it is not an empty box in the layout; `role="status"` with
    `aria-live="polite"` announces the result to a screen reader without
    stealing focus mid-typing.
  */}
  <p class="notify-status" data-notify-status role="status" aria-live="polite" hidden></p>

  <p class="fine">No pitch, no schedule promises. One email when there is
    something to use.</p>
</form>

{/*
  Turnstile's own script, deferred so it never blocks page render or the
  submit button. This is the one deliberate, allow-listed external load on
  the site — see tests/guards.spec.ts for the allow-list that names it.
*/}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Without this, the form is a NATIVE post: the browser navigates to
  // /subscribe and renders the Function's JSON response on screen. That is
  // what production did until 2026-08-25 -- a visitor who signed up
  // successfully was shown `{"ok":true}` as a web page. The signup was
  // saved; only this was broken.
  //
  // Enhancement, not a requirement: if this script fails to load or throws,
  // the form still posts natively, and functions/subscribe.ts answers a
  // non-fetch request with a redirect to /subscribed/ rather than JSON.
  // Both paths have to work, because either can be the one a visitor gets.
  const form = document.querySelector('form[data-notify]');
  const status = form && form.querySelector('[data-notify-status]');

  function say(message, ok) {
    if (!status) return;
    status.textContent = message;
    status.hidden = false;
    status.dataset.state = ok ? 'ok' : 'error';
  }

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      if (button) button.disabled = true;
      say('Signing you up…', true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          // The Function content-negotiates on this: with it, JSON comes
          // back; without it, a redirect. Sending it is what marks this as
          // the scripted path.
          headers: { Accept: 'application/json' },
        });

        // A non-JSON body is a real case, not a defensive flourish: if the
        // Function is ever undeployed, this receives the site's own 404
        // HTML. Parsing that as JSON throws, and an unhandled throw would
        // leave the form silent -- which to a visitor is indistinguishable
        // from the button not working.
        let body = null;
        try {
          body = await response.json();
        } catch {
          body = null;
        }

        if (response.ok && body && body.ok === true) {
          say("You're on the list. One email when there's something to use.", true);
          form.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
          return;
        }

        const reason = (body && typeof body.error === 'string')
          ? body.error
          : 'something went wrong';
        say(`Sorry — ${reason}. Please try again.`, false);
      } catch {
        // Offline, DNS failure, request blocked.
        say('Sorry — could not reach the server. Please try again.', false);
      }

      if (button) button.disabled = false;
      // Turnstile tokens are single-use. Without this reset, a second
      // attempt after any failure reuses a spent token and is rejected for
      // "verification required" forever -- the retry can never succeed.
      if (window.turnstile && typeof window.turnstile.reset === 'function') {
        window.turnstile.reset();
      }
    });
  }
</script>

<style>
  /* Off-screen rather than display:none — see the note above. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
